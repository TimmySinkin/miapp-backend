# Название базы, логин и пароль для контейнера Postgres — придумайте
# сами (это не логин от вашего аккаунта, просто новые учётные данные
# для этой конкретной базы). Запишите куда-нибудь — понадобятся, если
# захотите подключиться к базе напрямую для отладки.
DATABASE_NAME=miniapp
DATABASE_USERNAME=miniapp_user
DATABASE_PASSWORD=

# Дальше — те же значения, что уже были заданы как переменные
# окружения на Render. Просто скопируйте их оттуда (Render Dashboard →
# ваш сервис → Environment) один в один, ничего не меняя.
YANDEX_POSTBOX_ACCESS_KEY=
YANDEX_POSTBOX_SECRET_KEY=
YANDEX_BUCKET=
YANDEX_ACCESS_KEY=
YANDEX_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
